{
  "name": "node-rdap",
  "version": "0.5.1",
  "type": "module",
  "main": "./dist/tsc/client.js",
  "types": "./dist/tsc/client.d.ts",
  "files": [
    "dist/**/*"
  ],
  "repository": {
    "type": "git",
