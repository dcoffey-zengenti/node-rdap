    "ip-matching": "^2.1.2",
    "node-cache": "^5.1.2"
  },
  "engines": {
    "node": ">=20.19.0 || >=22.12.0"
  },
  "packageManager": "pnpm@12.0.0+sha512.9e2e3dc3911995868dc94b8175c217c27e95408fa03b4a22749778f2b34f773b77cdd3b39ede8171b22fcd53be6a35342e9fac9948a68ef58df6488ce89a7e67"
